# ---- IDE / 编辑器 ----
.idea/
*.iml
.vscode/

# ---- Python 产物 ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 含密钥的配置（appid / secret / 图床 token，切勿提交）----
*.yaml

# ---- 数据库 ----
*.db
*.sqlite
*.sqlite3

# ---- 日志 ----
*.log
*.log.*
logs/

